# Discord Developer Portal > 봇 > 토큰 (Chat 봇용 새 앱의 토큰)
DISCORD_TOKEN=
# 봇을 사용할 수 있는 Discord 사용자 ID (쉼표 구분)
ALLOWED_USER_IDS=
# 멘션 없이 모든 메시지에 반응할 채널 ID (이 채널 아래 스레드 포함). 잡담 채널 ID를 넣으세요.
LISTEN_CHANNEL_IDS=

BOT_NAME=chat
PERSONA_FILE=bots/chat/persona.md
WORKDIR=/apps/discordbot/workspace/chat
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# auto: 위험해 보이는 작업은 자동 차단 / bypassPermissions: 모든 CLI 명령 허용
CLAUDE_PERMISSION_MODE=auto
# false: "생각 중/작업 중/완료" 상태 메시지 없이 답변만 보냄
SHOW_STATUS=false
