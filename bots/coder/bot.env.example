# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# 봇을 사용할 수 있는 Discord 사용자 ID (쉼표 구분). 비어 있으면 아무도 사용 불가.
ALLOWED_USER_IDS=
# 멘션 없이도 모든 메시지에 반응할 채널 ID (선택). 비우면 멘션·답장·DM에만 반응 → 두 봇이 한 채널을 같이 쓸 때는 비워두기
LISTEN_CHANNEL_IDS=

BOT_NAME=coder
PERSONA_FILE=bots/coder/persona.md
WORKDIR=~
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# auto: 위험해 보이는 작업은 자동 차단 (권장) / bypassPermissions: 모든 작업 허용
CLAUDE_PERMISSION_MODE=auto
